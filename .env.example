# ============================================
# AI20K Project — Environment Variables
# ============================================
# Copy this file to .env and fill in the values you need.
# Never commit .env to git.

# This product is deployed for one company. The value is display metadata;
# users never create or switch companies in the application.
COMPANY_NAME=Orbit

# ---- LLM Configuration ----
# LLM_PROVIDER selects which client get_llm() builds: "google" (default), "groq", "openai", or "openrouter".
LLM_PROVIDER=google
GOOGLE_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
# OpenRouter is OpenAI-compatible. Never commit a real key.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_NAME=Orbit
OPENROUTER_REASONING_EFFORT=low
MODEL_NAME=gemini-2.5-flash
LLM_MAX_OUTPUT_TOKENS=384
# Workspace agents inherit LLM_PROVIDER/MODEL_NAME unless these are set.
# PRODUCT_DELIVERY_LLM_PROVIDER=google
# PRODUCT_DELIVERY_MODEL_NAME=gemini-2.5-flash
PRODUCT_DELIVERY_LLM_TEMPERATURE=0.2
PRODUCT_DELIVERY_LLM_MAX_OUTPUT_TOKENS=2048
PRODUCT_DELIVERY_LLM_REASONING_EFFORT=low
# Semantic routing inherits the Product Delivery synthesis provider/model by
# default, keeping it independent from specialist quota. Set these only when a
# dedicated routing model is desired; a distinct specialist model is failover.
# PRODUCT_DELIVERY_ROUTING_LLM_PROVIDER=openrouter
# PRODUCT_DELIVERY_ROUTING_MODEL_NAME=openai/gpt-5.6-luna
PRODUCT_DELIVERY_ROUTING_LLM_TEMPERATURE=0.0
PRODUCT_DELIVERY_ROUTING_LLM_MAX_OUTPUT_TOKENS=384
PRODUCT_DELIVERY_ROUTING_LLM_TIMEOUT_SECONDS=8
PRODUCT_DELIVERY_ROUTING_LLM_REASONING_EFFORT=low
PRODUCT_DELIVERY_CONVERSATION_LLM_ENABLED=true
PRODUCT_DELIVERY_CONVERSATION_LLM_TIMEOUT_SECONDS=12
# QUALITY_ASSURANCE_LLM_PROVIDER=google
# QUALITY_ASSURANCE_MODEL_NAME=gemini-2.5-flash
QUALITY_ASSURANCE_LLM_TEMPERATURE=0.1
QUALITY_ASSURANCE_LLM_MAX_OUTPUT_TOKENS=1024
# Enable the second model call only for optimistic high-risk conclusions
# (Delivery ON_TRACK and QA READY). It never authorizes a business action.
WORKSPACE_AGENT_VERIFIER_ENABLED=true
# WORKSPACE_AGENT_VERIFIER_PROVIDER=google
# WORKSPACE_AGENT_VERIFIER_MODEL_NAME=gemini-2.5-flash
WORKSPACE_AGENT_SNAPSHOT_PROMPT_MAX_CHARS=8000
WORKSPACE_AGENT_HISTORY_PROMPT_MAX_CHARS=8000
WORKSPACE_AGENT_VERIFIER_TEMPERATURE=0.0
WORKSPACE_AGENT_VERIFIER_MAX_OUTPUT_TOKENS=256
# Groq example: LLM_PROVIDER=groq, MODEL_NAME=openai/gpt-oss-20b (reliable tool-calling; get a key at https://console.groq.com/keys)
# OpenAI example: LLM_PROVIDER=openai, MODEL_NAME=gpt-4o-mini (get a key at https://platform.openai.com/api-keys)
# OpenRouter GPT-5.6 Luna example:
# LLM_PROVIDER=openrouter
# MODEL_NAME=openai/gpt-5.6-luna
# PRODUCT_DELIVERY_LLM_PROVIDER=openrouter
# PRODUCT_DELIVERY_MODEL_NAME=openai/gpt-5.6-luna
# PRODUCT_DELIVERY_SPECIALIST_LLM_PROVIDER=openrouter
# PRODUCT_DELIVERY_SPECIALIST_MODEL_NAME=openai/gpt-5.6-luna
# QUALITY_ASSURANCE_LLM_PROVIDER=openrouter
# QUALITY_ASSURANCE_MODEL_NAME=openai/gpt-5.6-luna
# Self-imposed daily token ceiling, purely for the usage warning on the Admin dashboard —
# not enforced by any provider, just an early-warning number you pick.
DAILY_TOKEN_BUDGET=350000

# ---- Multi-agent rollout ----
# Keep disabled until Agent Workspace membership, policy and security tests are ready.
MULTI_AGENT_ENABLED=false
PRODUCT_DELIVERY_AGENT_ENABLED=false
PRODUCT_DELIVERY_HYBRID_ROUTER_ENABLED=true
PRODUCT_DELIVERY_SUPERVISOR_ENABLED=true
PRODUCT_DELIVERY_TASK_SPECIALIST_ENABLED=true
PRODUCT_DELIVERY_RISK_SPECIALIST_ENABLED=true
PRODUCT_DELIVERY_PLANNING_SPECIALIST_ENABLED=true
PRODUCT_DELIVERY_EVIDENCE_SPECIALIST_ENABLED=true
PRODUCT_DELIVERY_CAPACITY_SPECIALIST_ENABLED=false
PRODUCT_DELIVERY_MULTI_SPECIALIST_WORKFLOWS_ENABLED=true
PRODUCT_DELIVERY_SPECIALIST_LLM_ENABLED=true
PRODUCT_DELIVERY_SPECIALIST_LLM_PROVIDER=
PRODUCT_DELIVERY_SPECIALIST_MODEL_NAME=openai/gpt-oss-20b
PRODUCT_DELIVERY_SPECIALIST_LLM_TEMPERATURE=0.1
PRODUCT_DELIVERY_SPECIALIST_LLM_MAX_OUTPUT_TOKENS=768
PRODUCT_DELIVERY_SPECIALIST_LLM_TIMEOUT_SECONDS=6
PRODUCT_DELIVERY_SPECIALIST_LLM_REASONING_EFFORT=low
PRODUCT_DELIVERY_MAX_SPECIALISTS_PER_WORKFLOW=4
PRODUCT_DELIVERY_WORKFLOW_TIMEOUT_SECONDS=40
QUALITY_ASSURANCE_AGENT_ENABLED=false
EXECUTIVE_AGENT_ENABLED=false
ALLOW_SELF_SERVICE_ORGANIZATION_CREATION=false
# Public test deployments only: auto-join active accounts to the shared company
# workspace so they can find one another and start direct chats.
OPEN_TEST_CHAT_ENABLED=false

# Workspace Agent fault boundary. `embedded` is the rollback-safe local mode.
# Docker Compose overrides Core to `remote` and starts the Product Delivery runtime on port 8010.
WORKSPACE_AGENT_RUNTIME_MODE=embedded
# Keep false for normal production. Set true only for the documented single-service
# free/demo deployment where both workspace agents intentionally run inside Core.
ALLOW_EMBEDDED_WORKSPACE_AGENTS_IN_PRODUCTION=false
WORKSPACE_AGENT_RUNTIME_URL=http://workspace-agent-product-delivery:8010
QUALITY_ASSURANCE_RUNTIME_URL=http://workspace-agent-quality-assurance:8011
WORKSPACE_AGENT_RUNTIME_SECRET=replace-with-a-separate-32-byte-internal-secret
QUALITY_ASSURANCE_RUNTIME_SECRET=replace-with-another-32-byte-internal-secret
WORKSPACE_AGENT_RUNTIME_TIMEOUT_SECONDS=45
WORKSPACE_AGENT_RUNTIME_QUEUE_TIMEOUT_SECONDS=2
WORKSPACE_AGENT_MAX_CONCURRENCY=4
WORKSPACE_AGENT_RUNTIME_SIGNATURE_MAX_AGE_SECONDS=60
WORKSPACE_AGENT_RUNTIME_WORKSPACE_ID=
WORKSPACE_AGENT_RUNTIME_PROFILE=product_delivery
WORKSPACE_AGENT_RUNTIME_VERSION=product-delivery-v2
QUALITY_ASSURANCE_RUNTIME_VERSION=quality-assurance-v2
# IDs in the P132 database currently used by this deploy branch. Change these
# only if you provision replacement agent_workspaces rows in another database.
PRODUCT_DELIVERY_AGENT_WORKSPACE_ID=9ff3ceb2b31f57238014e93e2402c0c8
QUALITY_ASSURANCE_AGENT_WORKSPACE_ID=311fe424edfa41989a495316b6925c84
WORKSPACE_AGENT_MEMORY_RETENTION_DAYS=30
WORKSPACE_AGENT_MEMORY_HISTORY_LIMIT=12
WORKSPACE_AGENT_MEMORY_MAX_CONTENT_CHARS=8000
WORKSPACE_AGENT_MEMORY_CLEANUP_INTERVAL_MINUTES=60

# ---- Database ----
# PostgreSQL is required for development and production. SQLite is reserved for unit tests.
DATABASE_URL=postgresql+asyncpg://orbit:orbit-local-password@localhost:5432/orbit
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=30

# ---- Auth ----
# Change this before production. Keep it secret.
SECRET_KEY=replace-with-at-least-32-random-bytes-before-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# The first account registered with this exact email becomes platform admin.
# Leave empty only when an imported database already contains a trusted admin.
INITIAL_ADMIN_EMAIL=

# ---- Auth — Google Sign-In ----
# "Sign in with Google" (ID-token verification only, no client secret) - unrelated to the "Google
# Calendar" section below, which is a separate, per-user OAuth Client (each user connects their
# OWN Calendar, not a shared account). Create a Web application OAuth Client ID (distinct from the
# Calendar section's Client) at https://console.cloud.google.com/apis/credentials, Authorized
# JavaScript origins: http://localhost:5173 for local dev. Must match Frontend/user/.env.local's
# VITE_GOOGLE_CLIENT_ID.
GOOGLE_OAUTH_CLIENT_ID=

# ---- App ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
# Development uses a restricted regex so localhost, private LAN, and Radmin VPN work on any port
# without hardcoding the current machine address. Production rejects this regex and requires
# exact trusted origins in CORS_ORIGINS.
CORS_ORIGINS=
CORS_ORIGIN_REGEX=^https?://(?:localhost|127\.0\.0\.1|10(?:\.\d{1,3}){3}|192\.168(?:\.\d{1,3}){2}|172\.(?:1[6-9]|2\d|3[01])(?:\.\d{1,3}){2}|26(?:\.\d{1,3}){3})(?::\d{1,5})?$

# ---- Google Calendar ----
# Create a separate Web OAuth client. Add only the least-privilege Calendar scope used by Orbit:
# https://www.googleapis.com/auth/calendar.events
# Refresh/access tokens are encrypted per user in PostgreSQL.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:8000/api/v1/calendar/oauth/callback
CALENDAR_TIMEZONE=Asia/Ho_Chi_Minh

# Fernet key encrypting each user's Calendar refresh_token at rest - generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# NEVER rotate once users have connected - every stored refresh_token becomes unreadable garbage
# and everyone has to reconnect. Empty = Calendar connect/use fails fast with a clear error
# instead of silently storing a plaintext secret.
CREDENTIAL_ENCRYPTION_KEY=

# Frontend origin - the OAuth callback page's postMessage back to the opener window is scoped to
# this origin only, so an unrelated page can't listen in on the "connected" signal.
FRONTEND_ORIGIN=http://localhost:5173
# How often (seconds) the backend polls Google Calendar for changes made outside the app (e.g.
# edited directly in Google Calendar) - real push notifications need a public HTTPS callback URL,
# which this project doesn't have without a real deployment, so this is the practical stand-in.
CALENDAR_POLL_INTERVAL_SECONDS=20

# ---- Request burst protection (single backend worker) ----
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_REGISTER=5/minute
RATE_LIMIT_CHAT=15/minute
RATE_LIMIT_READ=300/minute
RATE_LIMIT_CRUD=60/minute

# ---- Reminders / Scheduler ----
SCHEDULER_TIMEZONE=Asia/Ho_Chi_Minh


# ---- LangSmith (AI Logs — Deliverable #4) ----
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=true

# ---- Logging ----
LOG_LEVEL=INFO

# ---- Optional AI logging / tracing ----
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=ai20k-agent
# LANGCHAIN_TRACING_V2=true

# ---- Instructor-provided AI hook logging ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=
AI_LOG_DIR=.ai-log
# Enables the four click-to-login Product Delivery test accounts outside production.
DEMO_LOGIN_ENABLED=false
ALLOW_DEMO_LOGIN_IN_PRODUCTION=false
